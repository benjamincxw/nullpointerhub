# Neon Postgres connection string (used by the Drizzle client and drizzle-kit migrations)
DATABASE_URL=

# Resend
RESEND_API_KEY=
# Signing secret shown when you create the email.received webhook in the Resend dashboard
RESEND_WEBHOOK_SECRET=
# Verified sending address for the mail portal
MAIL_FROM_ADDRESS=hello@nullpointerhub.com

# Mail portal auth
# Shared password checked at /mail/login
MAIL_PORTAL_PASSWORD=
# Random 32+ byte secret used to sign the session cookie (JWT)
MAIL_PORTAL_SESSION_SECRET=

# Telegram bot notifications (from BotFather + getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Base URL used server-side to build links in Telegram notifications
APP_BASE_URL=https://nullpointerhub.com
